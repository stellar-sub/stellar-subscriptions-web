# Network the app opens on before a wallet is connected: testnet | mainnet
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# Optional RPC override (defaults to the public SDF endpoint for each network)
NEXT_PUBLIC_TESTNET_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

# Contract ids. Testnet defaults to the deployment recorded in
# stellar-subscriptions-contracts/DEPLOYMENTS.md; set these to point elsewhere.
NEXT_PUBLIC_TESTNET_SUBSCRIPTION_CONTRACT=CAW5H4BH5VXWR23DFUVMY45TL7JSMTDZTH3E7LMMXW5LZ7FMDL33KXMM
NEXT_PUBLIC_TESTNET_PLAN_CONTRACT=CDKFRKPA2EIYMW2GX2FY4ZFQ2VAFS5UZD5BHAZLCIGRA7N24N2DFAYN3
NEXT_PUBLIC_TESTNET_REGISTRY_CONTRACT=CB7HBXFNBLUSBY3SMIYUPVTE3JZTISYRMZB7XXPUC3ZPLIDNPTKUX645

# Mainnet is not deployed yet. Leave empty and the app shows a clear
# "not deployed on Mainnet" state instead of failing.
NEXT_PUBLIC_MAINNET_SUBSCRIPTION_CONTRACT=
NEXT_PUBLIC_MAINNET_PLAN_CONTRACT=
NEXT_PUBLIC_MAINNET_REGISTRY_CONTRACT=

# Any funded account on each network. Used only as the source of read-only
# simulations, which never spend anything.
NEXT_PUBLIC_TESTNET_READ_ACCOUNT=GBQHBOJHJ3SPU5TYNOABLKIXOZQFMN25ZNALA3QC46Q3I4IN5Q2KXZXI
NEXT_PUBLIC_MAINNET_READ_ACCOUNT=
